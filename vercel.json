{
    "version": 2,
    "buils":[
        {
            "src": "index.js",
            "use": "@vercel/node"
        },
        {
            "use": "@vercel/static-build",
            "config": {
                "distDir" : "dist/assets"
            }
        }
    ],
    "routes":[
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ]
}